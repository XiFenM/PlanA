# 已停用 Obsidian，不再跟踪其本地配置。
.obsidian/

# 英语子轨道：录音是个人语音数据 + 会让 git 历史膨胀，不入库；
# 文本（计划 / 日志 / 卡片）正常跟踪，方便版本化学习进度。
英语/**/*.m4a
英语/**/*.wav
英语/**/*.mp3

# playwright-cli 浏览器自动化的临时快照/日志，不入库
.playwright-cli/

# 面试材料：原始绩效附件与工作日志可能包含个人/公司敏感信息
面试准备/**/*.xlsx
面试准备/private/

# 中央 Agent Skill 生成视图与同步状态
/.agents/skills/
/.claude/skills/
/.agent-skills.state.json
/.agent-skills.state.json.tmp-*
/.agent-skills.lock
