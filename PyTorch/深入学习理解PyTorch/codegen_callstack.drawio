        <mxCell id="s3" value="at::add()&#10;C++ 前端 API・进入调度器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="246" width="280" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="c10::Dispatcher::call&#10;算 DispatchKeySet（grad→Autograd 最高）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="322" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="② VariableType::add&#10;autograd 记录：建 AddBackward0 / 连 next_edges / save 输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="402" width="280" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="at::redispatch::add()&#10;排除 Autograd key（剥开 variable）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="486" width="280" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="③ at::native::add —— kernel 函数体&#10;〔真正算加法・放 aten/native/〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="562" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="④ AT_DISPATCH(float32) switch&#10;〔在③函数体内・你手写〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="642" width="220" height="44" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="算子 schema 注册进 dispatch 表&#10;（op 符号得先『存在』才能被派发）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="320" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="RegisterCPU.cpp：TORCH_LIBRARY_IMPL&#10;把 kernel 绑到 CPU key&#10;〔注册挂钩=生成；函数体=手写〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="556" width="250" height="62" as="geometry" />
        </mxCell>

        <mxCell id="cb" value="逻辑推导（替代背诵）：一条 yaml = 一次『接口声明』。要让这个接口从 Python 调用一路抵达 kernel、再穿过 autograd —— 沿途每个『连接件』都是机械的、可由接口签名生成的（蓝／紫）；唯独两处是真正的『计算逻辑』、无法生成、必须你写（绿）：前向 kernel 函数体、反向公式（写在 derivatives.yaml 的那一行）。所以『生成了哪些东西』不是要背的清单，而是『调用链上除计算本身外的每一环』——把链走一遍，清单自己就长出来了。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="720" width="920" height="140" as="geometry" />
        </mxCell>

