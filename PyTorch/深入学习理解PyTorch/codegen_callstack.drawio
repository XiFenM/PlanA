      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="torch.add(a, b) 一次调用：调用栈（§3.2）× codegen 生成来源（§4.1）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="24" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="图例&#10;🟩 绿 = 你手写的『计算逻辑』（不可生成）&#10;🟦 蓝 = native_functions.yaml 生成的『接线』&#10;🟪 紫 = derivatives.yaml 生成的『接线』&#10;🟨 黄 = c10 既有框架（非本算子生成）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="native_functions.yaml&#10;（一条 func: entry）&#10;= 前向的『接口声明』" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="210" height="72" as="geometry" />
