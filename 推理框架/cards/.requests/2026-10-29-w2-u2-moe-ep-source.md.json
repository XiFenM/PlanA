  "cards": [
    {
      "key": "input-and-routing-skew",
      "rank": 1,
      "domain": "moe-communication",
      "recall_target": "区分输入倾斜与路由倾斜对全量汇聚和定向通信热点的影响",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "correction",
      "fields": {
        "意图": "在 MoE 专家并行中，如何区分输入数量不均与专家路由倾斜，并判断换通信后端能改变什么？",
        "场景": "比较 AgRs（AllGather＋ReduceScatter，全量汇聚输入）与只向目标 rank 发送 Token 的定向 All-to-All；Token 向量大小和 top-k 固定。分别考虑输入不变但路由集中，以及输入不均但路由均匀。",
        "正确": "先分开输入在哪与目标专家在哪：固定输入时，路由倾斜不改变全量汇聚的激活通信量，却可改变定向通信的热点；输入不均时，均匀路由也不能消除最忙发送方。",
        "错误": "allgather_reducescatter可能受影响更大",
        "说明": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "错误在于把输入归属与专家目标混成一种不均；应分别沿发送端和接收端定位。"
                }
              ]
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "某 rank 持有的 Token 多，它可能在两种后端中都成为发送瓶颈；总通信量不变不代表各方向均衡。"
                }
              ],
              "label": "输入端"
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "全量汇聚不按专家选择删减输入，定向发送的目标分布则随路由改变。"
                }
              ],
              "label": "目标端"
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "这里比较激活通信；AgRs 的通信量不变，不表示专家计算负载也不变。"
                }
              ]
            }
          ]
        }
      },
      "source_ids": [
        "w2-u2-log"
      ],
      "content_summary": "输入倾斜与路由倾斜的诊断；日志 msg-b5465a61f417efa7f284 至 msg-e4082364be91580724fe；A理由：防止把输入负载不均误诊为通信后端问题，导致选错优化层。",
      "depends_on": []
    },
    {
      "key": "received-rows-vs-expert-tasks",
      "rank": 2,
      "domain": "moe-communication",
      "recall_target": "区分通信接收行数与逻辑专家任务数的变化",
      "assessment": "discrimination",
