      "fields": {
        "问题": "单生产者、单消费者的单槽程序中，reader 同步读取本批，正常返回、不重入，也不保存借用。比较“reader 全程持锁”与“锁内登记占用状态 READING，解锁后执行 reader”两种方案：各自简化或增加了什么责任，对关闭协调有何影响？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "全程持锁用同一临界区直接保护读取，协议较简单；锁外读取缩短持锁时间，但必须另用占用状态约束生产者并在读取完成后交还。"
                }
              ]
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "其他需要状态锁的操作会等待 reader，包括 close；若接口允许 close 等锁，这仍是正确实现。"
                }
              ],
              "label": "全程持锁"
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "其他线程可以取得锁检查状态，但取得锁不代表获准覆写；必须一直保留 READING 的约束。"
                }
              ],
              "label": "锁外读取"
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "两种方案都须保持本批内容有效。是否采用锁外回调应依据接口和协调需求，不能把它当成正确性的必要门槛。"
                }
              ]
            }
          ]
        },
        "锚点": "简单临界区，与更细的占用协议",
