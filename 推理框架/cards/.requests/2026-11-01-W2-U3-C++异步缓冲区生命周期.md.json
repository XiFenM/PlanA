      "fields": {
        "问题": "异步队列会在提交函数返回后才读取一批数据，原先这批数据由调用方管理。比较三种安排：调用方继续持有、复制一份交给任务、移动所有权给任务。它们分别把成本或责任放在哪里？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "继续持有需要调用方配合完成协议；复制增加数据复制与独立存储成本；移动转交管理责任，原持有人不再负责被移走资源的所有权。"
                }
              ]
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "调用方须保证原存储和本批内容持续有效，直到实际读取结束，才能释放或复用。"
                }
              ],
              "label": "继续持有"
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "让任务持有独立副本，换来与原输入后续生命周期的分离；副本仍须由任务有效管理。"
                }
              ],
              "label": "复制"
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "把能够管理资源的对象交给任务保存，让所有权覆盖延迟访问；仅按值捕获裸指针没有完成这项转交。"
                }
              ],
              "label": "移动"
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "具体类型是否真正执行移动、是否复制，以及其移动后状态，要遵守该类型的语义。"
                }
              ]
            }
          ]
        },
        "锚点": "完成协议成本｜复制成本｜所有权转交",
