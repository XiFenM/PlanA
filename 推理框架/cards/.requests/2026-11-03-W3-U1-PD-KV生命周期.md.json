              ]
            },
            {
              "type": "point",
              "label": "内存级",
              "parts": [
                {
                  "type": "text",
                  "text": "MR 登记实际内存范围、长度和访问权限，并提供访问 key；它不只是通报一个地址。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "本卡只辨析层级，不声称已核验或运行某个NIXL后端的具体MR策略。"
                }
              ]
            }
          ]
        },
        "锚点": "本次请求的槽位；实际内存范围与访问条件",
