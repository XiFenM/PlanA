    {
      "key": "u2-mla-history-cost",
      "recall_target": "区分MLA免去历史展开的收益与仍随历史增长的attention工作",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "snapshot",
        "product": "vLLM / DeepSeek-V3 dense MLA",
        "commit": "d7ada3aace051fecec553c185225db2259c2ac6a"
      },
      "quality": "B",
      "template_id": "technical-qa",
      "fields": {
        "问题": "DeepSeek-V3 dense MLA 的普通 decode 路径（vLLM d7ada3aace05）保存 latent 与位置 key，并通过重排避免逐位置展开全部历史 K/V。在仍对完整有效历史执行 attention 的条件下，上下文继续增长会怎样影响主要读取与计算？优化究竟省掉了哪部分工作？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
