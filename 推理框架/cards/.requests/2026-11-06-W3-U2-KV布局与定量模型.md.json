    {
      "key": "u2-shared-link-lower-bound",
      "recall_target": "解释并发rank共享瓶颈时的传输下界及其证明范围",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "B",
      "template_id": "technical-qa",
      "fields": {
        "问题": "四个 rank 各有 S byte 的 payload，全部数据经过同一条总有效带宽为 W byte/s 的瓶颈链路，无重复读取或重试。怎样构造理想搬运时间下界？四路同时提交是否应再把下界除以四，这个结果又能否代表端到端交接延迟？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "共享瓶颈必须搬完合计 4S byte，理想下界为 4S/W；并发不增加这条链路的总带宽预算。"
                }
              ]
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "要先确认每 rank 是各自独占通路，还是共享同一带宽瓶颈；前者与本题是不同假设。"
                }
              ],
              "label": "预算归属"
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "该值只覆盖指定 payload 的理想搬运；排队、描述准备、重排、同步及消费者就绪还要沿真实关键路径观测。"
                }
              ],
              "label": "延迟范围"
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "并发是否额外引入竞争开销需测量，不能仅凭“同时提交”断言一定更慢或按 rank 数加速。"
                }
              ]
            }
          ]
        },
        "锚点": "先合计经过瓶颈的字节，再谈有效带宽与端到端边界",
