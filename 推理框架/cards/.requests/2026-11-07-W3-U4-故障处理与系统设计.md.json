      "template_id": "technical-qa",
      "fields": {
        "问题": "【PD 排险 2/5】远端节点在同一 IP/端口重启，新握手确认 engine 身份已经换了，但本地还有引用旧 peer 描述的在途传输。新请求和老传输各自怎么处理？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "label": "结论",
              "parts": [
                {
                  "type": "text",
                  "text": "地址没变但“人已换了”：新请求按新实例建新描述，老在途传输按老 handle 和老资源独立收尾。"
                }
              ]
            },
            {
              "type": "point",
              "label": "为何不能复用",
              "parts": [
                {
                  "type": "text",
                  "text": "IP/端口一样，新进程的显存布局、MR 注册和访问 key 全换了；重新握手也不会把已经提交的老传输自动迁过去。"
                }
              ]
            },
            {
              "type": "point",
              "label": "正确做法",
              "parts": [
                {
                  "type": "text",
                  "text": "保留老操作需要的本地关联，等它安全停止或完成、解除引用后再回收；要重试就当成一次新尝试重来。"
                }
              ]
            },
            {
              "type": "point",
              "label": "下集衔接",
              "parts": [
                {
                  "type": "text",
                  "text": "P 靠租约和心跳保源 KV，心跳迟到了能说明老读取已经停手了吗？"
                }
              ]
            },
            {
              "type": "boundary",
              "label": "踩坑点",
              "parts": [
                {
                  "type": "text",
                  "text": "别因为“业务地址没变”就让老传输继续往新重启的实例上重试。"
                }
              ]
            }
          ]
        },
        "锚点": "地址没变实例已换；新操作重建，老操作独立收尾",
        "来源": "W3-U4 学习记录 · u4-p04"
