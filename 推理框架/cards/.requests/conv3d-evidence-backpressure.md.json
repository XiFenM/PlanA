      "content_summary": "A理由：防止以逻辑元素数估算真实显存，遗漏布局、padding 或同时存活缓冲导致 OOM。",
      "fields": {
        "问题": "逻辑 Shape 相同，物理占用一定相同吗？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "不一定；逻辑 Shape 描述索引维度，实际占用还受布局、Stride、Padding 和分配规则影响。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "不能仅用逻辑元素数推定真实分配或模型峰值。"
                }
              ]
            }
          ]
        },
        "锚点": "逻辑索引与物理存储分开",
        "来源": "Conv3D／证据与反压结构化记录"
      },
      "depends_on": []
    },
