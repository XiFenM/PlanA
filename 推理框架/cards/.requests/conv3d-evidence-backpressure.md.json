        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "在候选分配阶段的前后分别取可比较的显存 snapshot，并记录对象的创建、存活和释放位置，比较增量发生在哪里。"
                }
