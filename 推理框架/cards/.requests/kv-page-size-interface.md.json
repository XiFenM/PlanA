      "recall_target": "把页字节跨度换算为 tensor 块维度的元素 stride",
      "layer": "atomic",
      "quality": "B",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 3,
      "template_id": "technical-qa",
      "source_ids": [
