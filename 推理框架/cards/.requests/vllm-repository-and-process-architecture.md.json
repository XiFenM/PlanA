      "recall_target": "解释在线前端与 enginecore 进程隔离的目的和 uni 边界",
      "layer": "mechanism",
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
