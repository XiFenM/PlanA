                }
              ]
            },
            {
              "type": "point",
              "parts": [
                {
                  "type": "text",
                  "text": "p_filesz 为 4 KiB、p_memsz 为 12 KiB 时，零初始化尾部为 8 KiB。"
                }
              ],
              "label": "例子"
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "文件无需保存同量零字节；元数据和对齐仍可能影响文件尺寸。"
                }
              ]
            }
          ]
        },
        "锚点": "零尾部 = p_memsz − p_filesz",
        "来源": "C++／Linux 基线结构化记录"
