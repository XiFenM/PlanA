    {
      "key": "class-object-versus-subclass",
      "domain": "python-type-introspection",
      "recall_target": "区分类对象检查与继承关系检查",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "B",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 3,
      "template_id": "technical-qa",
      "fields": {
        "问题": "isinstance(x, type) 与 issubclass(x, Base) 分别检查什么？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "前者检查 x 是否是类对象；后者检查类 x 与 Base 的继承关系。"
                }
              ]
            },
            {
              "type": "point",
              "label": "例子",
              "parts": [
                {
                  "type": "text",
                  "text": "str 是类对象，但不因此成为任意 Base 的子类。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "先确认 x 是类对象再做该继承检查；选定类本身不等于实例化。"
                }
              ]
            }
          ]
        },
        "锚点": "类对象身份／继承关系",
        "来源": "P1 实践记录 P1-11"
      },
      "content_summary": "区分类对象检查与继承关系检查",
      "depends_on": [],
      "rank": 4,
      "source_ids": [
        "p1-structured-log"
      ]
