    {
      "key": "backend-candidate-filter",
      "domain": "vllm-attention-selection",
      "recall_target": "区分自动后端的候选优先顺序与最终有效选择",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "snapshot",
        "product": "vllm",
        "version": "v0.26.0",
        "commit": "568afb3a13806beb53bb2e6bd518269357b237c0"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "vLLM 自动选择 Attention backend 时，排第一的候选一定会被采用吗？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "不一定；先验证候选能否导入及支持当前配置，再从有效候选中选优先级最高者。"
                }
              ]
            },
            {
              "type": "point",
              "label": "条件",
              "parts": [
                {
                  "type": "text",
                  "text": "设备能力、dtype、head size 等约束会影响候选是否有效。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "此处描述选择阶段，不是 kernel 执行失败后的自动切换。"
                }
              ]
            }
          ]
        },
        "锚点": "候选排序 → 校验 → 有效集合择优",
        "来源": "P1 实践记录 P1-04；vLLM v0.26.0"
      },
      "content_summary": "区分自动后端的候选优先顺序与最终有效选择",
      "depends_on": [],
      "rank": 1,
      "source_ids": [
        "p1-structured-log"
      ]
    },
    {
      "key": "explicit-backend-invalid",
      "domain": "vllm-attention-selection",
      "recall_target": "区分自动后端筛选与显式指定无效后端时的处理",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "snapshot",
        "product": "vllm",
        "version": "v0.26.0",
        "commit": "568afb3a13806beb53bb2e6bd518269357b237c0"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "vLLM 显式指定的 Attention backend 校验失败，会自动换一个吗？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "不会；该分支会抛出 ValueError。"
                }
              ]
            },
            {
              "type": "point",
              "label": "对照",
              "parts": [
                {
                  "type": "text",
                  "text": "自动模式才会排除无效候选，并从剩余有效候选中择优。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "按固定提交的实际控制流判断，不能仅凭相邻注释推断 fallback。"
                }
              ]
            }
          ]
        },
        "锚点": "显式指定失败 → 报错",
        "来源": "P1 实践记录 P1-04；vLLM v0.26.0"
      },
      "content_summary": "区分自动后端筛选与显式指定无效后端时的处理",
      "depends_on": [],
      "rank": 2,
      "source_ids": [
        "p1-structured-log"
      ]
    },
    {
      "key": "selection-versus-execution",
      "domain": "runtime-evidence",
      "recall_target": "区分实现选择函数成功与所选实现实际执行的证据",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "配置解析或后端选择器成功，能否证明所选 Runner／kernel 已执行？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "不能；只能证明相应配置或选择步骤在给定条件下成功。"
                }
              ]
            },
            {
              "type": "point",
              "label": "分层",
              "parts": [
                {
                  "type": "text",
                  "text": "读源码、构造配置、调用选择器、实例化执行对象、执行目标计算，是不同的证据层次。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "报告结论时写明真正执行到哪一层；后续层次需要各自的运行证据。"
                }
              ]
            }
          ]
        },
        "锚点": "选择成功 ≠ 目标计算已执行",
        "来源": "P1 实践记录 P1-03、P1-12"
      },
      "content_summary": "区分实现选择函数成功与所选实现实际执行的证据",
      "depends_on": [],
      "rank": 3,
      "source_ids": [
        "p1-structured-log"
      ]
