      ]
    },
    {
      "key": "inherited-environment",
      "domain": "linux-process-environment",
      "recall_target": "解释脚本未再次export时子进程仍继承已有环境变量",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "B",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 3,
      "template_id": "technical-qa",
      "fields": {
        "问题": "脚本没有执行 export 分支，启动的 app 还能继承已有 LD_LIBRARY_PATH 吗？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "可以；从父环境传入并保留在脚本环境中的变量，会继续传给子进程。"
                }
              ]
            },
            {
              "type": "point",
              "label": "本例",
              "parts": [
                {
                  "type": "text",
                  "text": "父路径已经是 A，修复分支不执行，app 仍继承 A 并正常调用。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "这与仅创建了未导出的 shell 局部变量不同。"
                }
              ]
            }
          ]
        },
        "锚点": "继承的环境变量无需重复 export",
        "来源": "P2 实践记录 P2-07"
      },
      "content_summary": "解释脚本未再次export时子进程仍继承已有环境变量",
