  "cards": [
    {
      "key": "ep-not-always-alltoall",
      "rank": 1,
      "domain": "moe-parallelism",
      "recall_target": "纠正EP必然触发All-to-All的判断",
      "assessment": "discrimination",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "correction",
      "fields": {
        "意图": "仅凭启用 EP 能否断言一定有 All-to-All？请给出一种不需要跨卡 dispatch 的布局，并说明如何合并结果。",
        "场景": "讨论的是一次 MoE 前向；各逻辑专家分别由一个 rank 负责，具体输入和输出布局需要说明。",
        "正确": "不能。若各卡已有完整同序输入，可分别计算本地专家贡献，再按同一 Token 做 SUM AllReduce。",
        "错误": "我一直以为开启ep之后必定会有all2all通信在moe计算中。",
        "说明": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "EP 描述专家参数的分布；通信由激活布局、专家归属及输出布局共同决定。"
                }
              ]
            },
            {
              "type": "point",
              "label": "反例",
              "parts": [
                {
                  "type": "text",
                  "text": "各 rank 持有相同输入，只计算本地选中专家的加权贡献；无贡献的位置为零。SUM AllReduce 后各 rank 得到完整输出。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "反例要求同一逻辑分配不被重复计算，且最终输出需要复制到各 rank；不能外推所有框架配置。来源：学习记录 §3。"
                }
              ]
            }
          ]
        }
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "纠正EP必然触发All-to-All的判断",
      "depends_on": []
    },
    {
      "key": "ep-input-axes",
      "rank": 2,
      "domain": "moe-parallelism",
      "recall_target": "区分专家参数分布与Token激活的切分轴",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "启用 EP 后，能否判断各卡原始 Token 一定不同，或每个 Token 的 H 维向量一定被切开？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "不能。专家参数归属、Token 行分布和隐藏维切分是不同的布局问题。"
                }
              ]
            },
            {
              "type": "point",
              "label": "维度",
              "parts": [
                {
                  "type": "text",
                  "text": "X 的形状为 [T,H]。沿 T 分片是不同 Token 分到不同设备；沿 H 分片是拆开单个 Token 的隐藏向量。"
                }
              ]
            },
            {
              "type": "point",
              "label": "执行",
              "parts": [
                {
                  "type": "text",
                  "text": "在不叠加专家内部 TP 的算例中，每个选中专家消费完整的 H 维输入；初始 Token 是否复制还取决于 DP、TP、SP 等组合。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "判断 dispatch 要同时固定输入位置、专家位置和最终输出归属；专家同卡不保证没有跨卡往返。"
                }
              ]
            }
          ]
        },
        "锚点": "专家归属／Token 行／隐藏维分别判断",
        "来源": "W2 单元一学习记录 · §1–2"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "区分专家参数分布与Token激活的切分轴",
      "depends_on": []
    },
    {
      "key": "routing-count-invariants",
      "rank": 3,
      "domain": "moe-routing",
      "recall_target": "核对top-k分配总数和单专家Token数上界",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "T 个 Token 各选择 K 个不同的逻辑专家，且不丢弃分配。总专家任务数和单个专家任务数分别满足什么约束？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "总分配数为 TK；每个逻辑专家最多收到 T 个 Token。"
                }
              ]
            },
            {
              "type": "display",
              "parts": [
                {
                  "type": "formula",
                  "katex": "\\sum_e n_e=TK,\\qquad 0\\le n_e\\le T"
                }
              ]
            },
            {
              "type": "point",
              "label": "含义",
              "parts": [
                {
                  "type": "text",
                  "text": "n_e 统计路由给逻辑专家 e 的 Token–expert 分配。一个 Token 在这里不能多次选择同一个逻辑专家。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "丢弃 D 条分配后，保留任务数变为 TK−D；padding 槽位和物理冗余副本不应被计作新增逻辑分配。"
                }
              ]
            }
          ]
        },
        "锚点": "先固定逻辑分配与丢弃规则",
        "来源": "W2 单元一学习记录 · §4、11–12"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "核对top-k分配总数和单专家Token数上界",
      "depends_on": []
    },
    {
      "key": "expert-output-not-reusable",
      "rank": 4,
      "domain": "moe-correctness",
      "recall_target": "区分相同输入存储与不同专家输出的复用",
      "assessment": "discrimination",
      "layer": "atomic",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "同一个隐藏向量 x 同时被专家 E0 和 E2 选中。能否只计算 E0(x)，再将其结果复用为 E2(x)？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "一般不能；两个专家的参数不同，输入相同不足以证明输出等价。"
                }
              ]
            },
            {
              "type": "point",
              "label": "任务身份",
              "parts": [
                {
                  "type": "text",
                  "text": "一条专家计算任务由 Token 输入和专家参数共同确定。两个专家可以读取同一份输入存储，但仍需分别完成各自的计算。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "偶然得到相同数值也不是普遍可复用的依据；只有另有等价性证明时才能采用相应优化。"
                }
              ]
            }
          ]
        },
        "锚点": "共享输入不等于共享计算结果",
        "来源": "W2 单元一学习记录 · §5"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "区分相同输入存储与不同专家输出的复用",
      "depends_on": []
    },
    {
      "key": "permutation-weighted-restore",
      "rank": 5,
      "domain": "moe-routing",
      "recall_target": "解释top-k展开后的结果如何还原原Token",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "MoE 将 T 个 Token 按 top-k 展开，并按专家重新排列为 TK 条任务。专家计算后，为什么仅按原 Token 编号排序还不够？需要保留哪些映射？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "还必须按原 Token 汇合对应专家结果，并使用正确路由权重求和，才能恢复 T 个输出向量。"
                }
              ]
            },
            {
              "type": "point",
              "label": "映射",
              "parts": [
                {
                  "type": "text",
                  "text": "每条打包结果需要能定位原 Token，以及该分支对应的专家或路由权重；打包行号不是最终输出 Token 编号。"
                }
              ]
            },
            {
              "type": "point",
              "label": "符号",
              "parts": [
                {
                  "type": "text",
                  "text": "x_t 是 Token t 的输入隐藏向量，S_t 是选中的专家集合，g_{t,e} 是对应路由权重，E_e 是专家 e 的函数，y_t 是还原后的输出。"
                }
              ]
            },
            {
              "type": "display",
              "parts": [
                {
                  "type": "formula",
                  "katex": "y_t=\\sum_{e\\in S_t}g_{t,e}E_e(x_t)"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "公式采用不丢弃分配的约定；若有容量处理，应先按模型规则确定有效分配与权重。"
                }
              ]
            }
          ]
        },
        "锚点": "展开→按专家计算→按原Token加权汇合",
        "来源": "W2 单元一学习记录 · §6"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "解释top-k展开后的结果如何还原原Token",
      "depends_on": []
    },
    {
      "key": "dispatch-dedup-unit",
      "rank": 6,
      "domain": "moe-communication",
      "recall_target": "依据目标设备去重规则计算激活传输量",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "假设不使用专家内部 TP，隐藏维为 H、每元素 b 字节。源 GPU r 与目标 GPU s 不同，s 尚未持有所需输入，dispatch 对“同一 Token、同一目标 GPU”只发一份。如何计算 r→s 的激活载荷？若两个目标 GPU 位于同一节点，能否自动再去重？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "按需要从 r 传到 s 的不同 Token 数 U_{r→s} 计费；节点级去重必须另外明确，不能自动假定。"
                }
              ]
            },
            {
              "type": "display",
              "parts": [
                {
                  "type": "formula",
                  "katex": "D_{r\\to s}=U_{r\\to s}\\,H\\,b"
                }
              ]
            },
            {
              "type": "point",
              "label": "重复消费",
              "parts": [
                {
                  "type": "text",
                  "text": "同一目标 GPU 上多个专家可以消费一次收到的完整向量；发往不同 GPU 的分配仍是不同目标。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "不做节点级去重时，同一 Token 发往远端节点两张 GPU 的两份载荷都计入源节点→目标节点方向的链路载荷；这里只计激活，不含元数据、padding 或协议开销。"
                }
              ]
            }
          ]
        },
        "锚点": "去重粒度是目标GPU还是目标节点",
        "来源": "W2 单元一学习记录 · §4、7"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "依据目标设备去重规则计算激活传输量",
      "depends_on": []
    },
    {
      "key": "local-combine-payload",
      "rank": 7,
      "domain": "moe-communication",
      "recall_target": "解释回传前局部加权合并如何减少向量份数",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "同一 Token 的多个选中专家位于同一远端 GPU，且该 GPU 已获得路由权重。如何减少 combine 回传向量份数，同时保持原加权和的数学关系？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "先在远端 GPU 按原 Token 合并本卡专家的加权贡献，再回传一个部分结果向量。"
                }
              ]
            },
            {
              "type": "point",
              "label": "符号",
              "parts": [
                {
                  "type": "text",
                  "text": "x_t 是 Token t 的输入，g_{t,e} 是路由权重，E_e 是专家函数；A_{t,s} 是实际指派给 GPU s 执行的该 Token 专家分支集合，r_t^{(s)} 是本卡贡献，y_t 是最终输出。"
                }
              ]
            },
            {
              "type": "display",
              "parts": [
                {
                  "type": "formula",
                  "katex": "r_t^{(s)}=\\sum_{e\\in A_{t,s}}g_{t,e}E_e(x_t),\\qquad y_t=\\sum_s r_t^{(s)}"
                }
              ]
            },
            {
              "type": "point",
              "label": "分配",
              "parts": [
                {
                  "type": "text",
                  "text": "对 s 的求和包括来源卡自身；每条逻辑分配只计一次。有冗余专家副本时，A_{t,s} 按实际执行分配确定，不能把所有持有同名专家的卡都计入。"
                }
              ]
            },
            {
              "type": "point",
              "label": "权重",
              "parts": [
                {
                  "type": "text",
                  "text": "只有一个本地分支时也应按该规则乘权重；来源卡收到已加权贡献后直接合并，不能再次重复乘同一权重。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "需要明确权重可用性、回传数据类型与实际合并策略；数学关系相同不构成浮点逐位一致或性能收益的实测证明。"
                }
              ]
            }
          ]
        },
        "锚点": "按Token合并本卡贡献，再回来源卡",
        "来源": "W2 单元一学习记录 · §8"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "解释回传前局部加权合并如何减少向量份数",
      "depends_on": []
    },
    {
      "key": "communication-resource-bound",
      "rank": 8,
      "domain": "communication-modeling",
      "recall_target": "按独立与共享带宽资源推导通信时间下界",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "在理想载荷模型中，为什么不能总用所有通信字节之和除以一个链路带宽？请区分独立全双工方向、共享同向出口和严格串行阶段。",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "先识别哪些流量共享同一资源，再按资源的总载荷和带宽求下界。"
                }
              ]
            },
            {
              "type": "point",
              "label": "独立方向",
              "parts": [
                {
                  "type": "text",
                  "text": "两个方向可同时使用各自带宽时，阶段下界取两方向传输时间的最大值。例如 48MB／16MB，各方向16GB/s，下界为3ms。"
                }
              ]
            },
            {
              "type": "point",
              "label": "共享出口",
              "parts": [
                {
                  "type": "text",
                  "text": "同向流共享出口时先合计载荷。例如32MB和16MB共用16GB/s出口，下界为3ms。"
                }
              ]
            },
            {
              "type": "point",
              "label": "阶段依赖",
              "parts": [
                {
                  "type": "text",
                  "text": "严格串行阶段的各阶段下界相加；发送与接收是同批载荷，不重复计一次传输。"
                }
              ]
            },
            {
              "type": "boundary",
              "parts": [
                {
                  "type": "text",
                  "text": "例中单位为十进制，忽略启动、协议、计算及其他争用；阶段重叠或拓扑变化时必须重新建模。"
                }
              ]
            }
          ]
        },
        "锚点": "独立取最大，共享先求和，串行再相加",
        "来源": "W2 单元一学习记录 · §9"
      },
      "source_ids": [
        "w2-u1-log"
      ],
      "content_summary": "按独立与共享带宽资源推导通信时间下界",
      "depends_on": []
    },
    {
      "key": "placement-eplb-router",
      "rank": 9,
      "domain": "moe-load-balancing",
      "recall_target": "区分逻辑路由专家放置与EPLB的职责",
      "assessment": "mechanism",
      "layer": "mechanism",
      "fact_scope": {
        "kind": "evergreen"
      },
      "quality": "A",
      "fact_status": "verified",
      "lifecycle": "active",
      "priority": 5,
      "template_id": "technical-qa",
      "fields": {
        "问题": "router、专家 placement、EP 和 EPLB 分别决定什么？为了均衡设备任务数，能否把某 Token 选中的 E2 直接换成参数不同的 E1？",
        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "不能把移动专家位置等同于替换逻辑专家函数。"
                }
              ]
            },
            {
              "type": "point",
              "label": "路由与放置",
              "parts": [
                {
                  "type": "text",
                  "text": "router 为当前 Token 选择逻辑专家及权重；placement 将逻辑专家映射到物理设备；EP 使不同专家在多个设备上执行。"
                }
              ]
            },
            {
              "type": "point",
              "label": "负载调整",
              "parts": [
                {
                  "type": "text",
