        "答案": {
          "blocks": [
            {
              "type": "lead",
              "parts": [
                {
                  "type": "text",
                  "text": "router 决定选择哪些逻辑专家及其加权贡献；SwiGLU gate 调制单个专家内部的中间特征通道。"
                }
              ]
